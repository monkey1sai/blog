---
import { NAV, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import { getPosts } from '../lib/content';
const hasPosts = (await getPosts()).length > 0;
const navigation = NAV.filter((item) => item.href !== '/blog/' || hasPosts);

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => {
  const h = href.replace(/\/+$/, '') || '/';
  return h === '/' ? path === '/' : path === h || path.startsWith(h + '/');
};
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} 首頁`}>
      <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="bm" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#8E3945" /><stop offset="1" stop-color="#B58A4A" />
          </linearGradient>
        </defs>
        <rect x="1" y="1" width="30" height="30" rx="8" fill="none" stroke="url(#bm)" stroke-width="2" />
        <path d="M9 21 L13.5 10 L18 21 M10.8 17 H16.2" fill="none" stroke="url(#bm)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="22.5" cy="20" r="2.3" fill="url(#bm)" />
      </svg>
      <span class="brand-name">許竣傑 <span>· AI Craft Lab</span></span>
    </a>
    <nav class="nav" aria-label="主選單">
      {navigation.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
