---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, getProjects, type Post, type Project } from '../../lib/content';

export async function getStaticPaths() {
  const [projects, posts] = await Promise.all([getProjects(), getPosts()]);
  const tags = new Set([...projects.flatMap((p) => p.data.tags), ...posts.flatMap((p) => p.data.tags)]);
  return [...tags].sort().map((tag) => ({
    params: { tag },
    props: {
      projects: projects.filter((p) => p.data.tags.includes(tag)),
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

interface Props { projects: Project[]; posts: Post[] }
const { projects, posts } = Astro.props;
const { tag } = Astro.params;
---

<BaseLayout title={`#${tag}`} description={`標記為「${tag}」的作品與文章。`}>
  <div class="container" style="padding-bottom:var(--space-section)">
    <header class="page-header">
      <p class="eyebrow">Tag</p>
      <h1>#{tag}</h1>
    </header>
    {projects.length > 0 && (
      <section style="margin-bottom:2.5rem">
        <h2 style="font-size:1.25rem">作品</h2>
        <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
      </section>
    )}
    {posts.length > 0 && (
      <section>
        <h2 style="font-size:1.25rem">文章</h2>
        <PostList posts={posts} />
      </section>
    )}
  </div>
</BaseLayout>
