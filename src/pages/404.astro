---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="找不到頁面" description="這個頁面不存在或已經移動。" noindex>
  <div class="container" style="padding-block:var(--space-section);text-align:center">
    <p class="prompt">$ error 404 — page not found</p>
    <h1>找不到這個頁面</h1>
    <p class="muted">網址可能打錯了，或是頁面已經搬家。</p>
    <div class="btn-row" style="justify-content:center;margin-top:1.5rem">
      <a class="btn btn-primary" href="/">回到首頁</a>
      <a class="btn" href="/projects/">看作品集</a>
    </div>
  </div>
</BaseLayout>
