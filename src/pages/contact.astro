---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../consts';
const notes: Record<string, string> = {
  X: '最新動態與作品更新',
  Threads: '日常開發紀錄',
  GitHub: '公開的原始碼與專案',
  YouTube: '遊戲與 AI 作品影片',
  'itch.io': '可以直接玩的遊戲',
};
---

<BaseLayout title="聯絡" description="想交流實作心得？透過 X、Threads、GitHub、YouTube 或 itch.io 找到許竣傑。">
  <div class="container" style="padding-bottom:var(--space-section)">
    <header class="page-header">
      <p class="eyebrow">Contact</p>
      <h1>有具體想法，聊聊怎麼做。</h1>
      <p>遊戲、AI 協作工具、互動音訊與工程流程，都歡迎交流。可以透過下面既有的公開帳號找到我。</p>
    </header>
    <div class="prose contact-note"><h2>可以從這三件事開始</h2><ul><li>你想解決什麼問題？</li><li>目前已經有什麼作品或嘗試？</li><li>希望最後能看到什麼結果？</li></ul><p>有公開網址或畫面，可以一併提供；請勿傳送密碼、金鑰或機密資料。</p></div>
    <ul class="social-grid">
      {SOCIALS.map((s) => (
        <li>
          <a href={s.url} rel="me noopener" target="_blank">
            <strong>{s.name} ↗</strong>
            <span>{s.handle}</span><br />
            <span>{notes[s.name]}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
