---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, SOCIALS } from '../consts';
import { getPosts } from '../lib/content';
const hasPosts = (await getPosts()).length > 0;

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  noindex = false,
  jsonLd,
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = title ? `${title}｜${SITE.name}` : `${SITE.name}｜${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(SITE.ogImage, Astro.site);

const personLd = {
  '@type': 'Person',
  '@id': new URL('/#person', Astro.site).href,
  name: SITE.author,
  alternateName: SITE.handle,
  url: new URL('/', Astro.site).href,
  sameAs: SOCIALS.map((s) => s.url),
};
const ld = jsonLd ?? null;
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="author" content={SITE.author} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#20252B" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3EBDD" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {hasPosts && <link rel="alternate" type="application/rss+xml" title={`${SITE.name} 文章`} href={new URL('/rss.xml', Astro.site)} />}
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}：${SITE.tagline}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@monkey1sai" />
    <meta name="twitter:creator" content="@monkey1sai" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700&family=Inter:wght@400;600;700&display=swap"
    />

    <!-- 主題：先讀已儲存偏好，否則使用暖紙淺色；放在 head 避免閃爍 -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('theme');
          const theme = saved === 'light' || saved === 'dark'
            ? saved
            : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (_) {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': [personLd, ...(ld ? (Array.isArray(ld) ? ld : [ld]) : [])] })} />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要內容</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
